# Copy to .env and fill in locally. Never commit .env.
# Names only here; no values.

# Global Fishing Watch API (non-commercial use only)
GFW_API_TOKEN=

# aisstream.io live AIS (demo only)
AISSTREAM_API_KEY=

# Digitraffic asks clients to identify themselves in the Digitraffic-User header
DIGITRAFFIC_USER=

# OpenSanctions API (non-commercial use only; optional)
OPENSANCTIONS_API_KEY=

# LLM provider for PDF extraction and vessel-card narratives
ANTHROPIC_API_KEY=
