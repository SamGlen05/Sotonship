# Secrets
.env
.env.*
!.env.example

# Personal Claude Code settings
.claude/settings.local.json
CLAUDE.local.md

# Data: raw downloads and interim tables are not committed
data/raw/*
data/interim/*
!data/raw/.gitkeep
!data/interim/.gitkeep

# Large processed files (keep small results tables and manifests)
data/processed/*.parquet

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# OS and editors
.DS_Store
.vscode/
.idea/

# Provenance metadata is committed (URLs, retrieval times, checksums, row counts), not the data
!data/raw/manifest.jsonl
!data/interim/*.manifest.json
data/raw/dma_ais/_download.log

# Generated dashboard data (derived from data/, regenerate with sfp.score)
app/data/
# Model binaries are regenerated by sfp.model / sfp.score
data/processed/model_lgbm.txt
data/processed/_*.log
data/processed/model_lgbm_global.txt
